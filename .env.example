# PRDiffer MCP Server — environment template
# Copy to `.env` and fill in values:  cp .env.example .env
# Loaded by: start-prdiffer-mcp-server.sh (source) and prdiffer/server.py (load_dotenv)

# ---------------------------------------------------------------------------
# Provider tokens (at least one required)
# ---------------------------------------------------------------------------
# GitHub personal access token (repo / pull_request scopes as needed)
GITHUB_TOKEN=

# GitLab personal access token (api or read_api + read_repository)
GITLAB_TOKEN=

# ---------------------------------------------------------------------------
# GitLab host allowlist (strict full-diff)
# ---------------------------------------------------------------------------
# Comma-separated bare hostnames (case-insensitive). Default when unset:
# settings.toml gitlab.allowed_hosts → ["gitlab.com"]
#
# Override for custom / self-hosted GitLab (must match MR URL host):
# GITLAB_ALLOWED_HOSTS=gitlab.com,gitlab.example.com
#
# Security: only list hosts you trust; tokens are sent to allowlisted hosts.
GITLAB_ALLOWED_HOSTS=gitlab.com

# ---------------------------------------------------------------------------
# Full-diff admission limits (optional)
# ---------------------------------------------------------------------------
# Max selected files admitted for a PR/MR full-context diff (GitHub + GitLab).
# Default when unset: settings.toml app.max_files_allowed → 50.
# Must be a positive integer; exceeding the limit fails closed (E5020).
# Loaded by start-prdiffer-mcp-server.sh (source .env) and SettingsService.
# MAX_FILES_ALLOWED=50

# ---------------------------------------------------------------------------
# GitHub ignore file list (optional)
# ---------------------------------------------------------------------------
# Comma-separated path globs / patterns skipped before full-diff admission.
# When set, replaces settings.toml github.ignore_patterns entirely (does not
# append). Leave unset to use the defaults in settings.toml (locks, images,
# node_modules/, hidden files, etc.). GitLab has no ignore-pattern filter.
#
# Always quote the value so shells do not expand ``*`` globs when sourcing .env.
# Patterns match the full repo-relative path and the basename (so *AGENTS.md
# ignores both AGENTS.md and prdiffer/domain/AGENTS.md).
#
# Examples:
#   GITHUB_IGNORE_PATTERNS="*.lock,node_modules/,dist/,*.min.js"
#   GITHUB_IGNORE_PATTERNS="vendor/,*.generated.go,package-lock.json,*AGENTS.md"
#
# GITHUB_IGNORE_PATTERNS="*.lock,node_modules/,dist/,build/,*.png,*.jpg,*AGENTS.md"

# ---------------------------------------------------------------------------
# MCP transport / bind (optional; start script also accepts --transport/--port)
# ---------------------------------------------------------------------------
# MCP_TRANSPORT=http
# MCP_PORT=9102
# MCP_HOST=127.0.0.1
# MCP_PATH=/mcp

# ---------------------------------------------------------------------------
# MCP authentication (optional)
# ---------------------------------------------------------------------------
# MCP_AUTH_ENABLED=false
# MCP_API_KEYS=sk_dev_example_key_change_me
# MCP_ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# Dynaconf environment switcher (optional)
# ---------------------------------------------------------------------------
# ENV_FOR_DYNACONF=default
